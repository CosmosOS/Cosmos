<Project>
  <PropertyGroup>
    <ToolCommonPath>$(MSBuildThisFileDirectory)dotnet\runtime\src\coreclr\tools\Common\</ToolCommonPath>
    <AotCommonPath>$(MSBuildThisFileDirectory)dotnet\runtime\src\coreclr\nativeaot\Common\src\</AotCommonPath>
    <AotRuntimeBasePath>$(MSBuildThisFileDirectory)dotnet\runtime\src\coreclr\nativeaot\Runtime.Base\src\</AotRuntimeBasePath>
    <CompilerCommonPath>$(MSBuildThisFileDirectory)dotnet\runtime\src\coreclr\nativeaot\Common\src\</CompilerCommonPath>
  </PropertyGroup>
  <!-- Property side of CosmosTrackPublicApi (see Directory.Build.props for the
       flag's documentation). Must live here and not in the props: props are
       imported before the project body sets the flag, so property conditions
       on it never fire there. This file is imported after the project body. -->
  <PropertyGroup Condition="'$(CosmosTrackPublicApi)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(CosmosApiBaselineVersion)' != ''">$(CosmosApiBaselineVersion)</PackageValidationBaselineVersion>
    <!-- RS0017 (stale txt entry) has no source location, so the .editorconfig
         [*.cs] severity=error never applies to it; promote it here. RS0016 must
         NOT be promoted this way: /warnaserror outranks .editorconfig and would
         trample the per-file severity=none exclusions (LibraryInitializer,
         KernelVersion.g.cs); its editorconfig error severity already works. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0017</WarningsAsErrors>
  </PropertyGroup>

  <!-- A tracked public surface must be documented, so CS1591 (missing XML doc)
       is suppressed everywhere except there. Adding the suppression here is
       what makes the condition possible: the props are imported before the
       project body sets CosmosTrackPublicApi, so a property condition on the
       flag is always false there. The error severity comes from the
       .editorconfig [*.cs] section, not WarningsAsErrors, so it only reaches
       files this repo's .editorconfig governs; sources linked from the
       dotnet/runtime submodule keep their default severity. -->
  <PropertyGroup Condition="'$(CosmosTrackPublicApi)' != 'true'">
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <Target Name="EnforceKernelReferenceRules" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <IsExcluded>$(MSBuildProjectName).StartsWith('Cosmos.Kernel')</IsExcluded>
    </PropertyGroup>
    <ItemGroup>
      <ForbiddenReference Include="@(ProjectReference)"
                           Condition="$(IsExcluded) == false and $([System.String]::Copy('%(ProjectReference.Identity)').Contains('Cosmos.Kernel.Boot'))" />
    </ItemGroup>
    <Error Condition="@(ForbiddenReference) != ''"
           Text="Only the Cosmos.Kernel project may reference Cosmos.Kernel.Boot.* projects."
           />
  </Target>

  <!--
    A driver assembly (one named in CosmosDriverAssemblyNames, declared in
    Directory.Build.props) holds no InternalsVisibleTo grant from any project, and the
    compiler is then the proof that it uses only the public driver kit seam: the assembly
    can call only what a third party can call. This target keeps that proof from eroding
    quietly. A grant naming a driver assembly, whether as an InternalsVisibleTo item or as
    an AssemblyAttribute item for InternalsVisibleToAttribute, fails the granting project's
    build. The fix is never the grant: add the missing capability to the driver kit.
  -->
  <Target Name="CosmosForbidDriverAssemblyGrants" BeforeTargets="BeforeBuild" Condition="'$(CosmosDriverAssemblyNames)' != ''">
    <PropertyGroup>
      <!-- Lower case, no blanks around the separators: a grant is matched the way
           the compiler matches it, by assembly name and ignoring case. -->
      <_CosmosDriverAssemblyNamesNormalized>;$([System.Text.RegularExpressions.Regex]::Replace('$(CosmosDriverAssemblyNames)', '\s*;\s*', ';').Trim().ToLowerInvariant());</_CosmosDriverAssemblyNamesNormalized>
    </PropertyGroup>
    <ItemGroup>
      <_CosmosGrantedAssembly Include="@(InternalsVisibleTo)" />
      <_CosmosGrantedAssembly Include="@(AssemblyAttribute->'%(_Parameter1)')"
                              Condition="'%(AssemblyAttribute.Identity)' == 'System.Runtime.CompilerServices.InternalsVisibleToAttribute' or '%(AssemblyAttribute.Identity)' == 'System.Runtime.CompilerServices.InternalsVisibleTo'" />
      <!-- The assembly name alone: a public key after the comma does not change which assembly is granted. -->
      <_CosmosGrantedAssembly>
        <Normalized>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', ',.*$', '').Trim().ToLowerInvariant())</Normalized>
      </_CosmosGrantedAssembly>
      <_CosmosForbiddenDriverGrant Include="@(_CosmosGrantedAssembly)"
                                   Condition="$(_CosmosDriverAssemblyNamesNormalized.Contains(';%(_CosmosGrantedAssembly.Normalized);'))" />
    </ItemGroup>
    <Error Condition="'@(_CosmosForbiddenDriverGrant)' != ''"
           Text="$(MSBuildProjectName) grants InternalsVisibleTo to a driver assembly (@(_CosmosForbiddenDriverGrant, ', ')). A driver assembly uses only the public driver kit seam, and the compiler is the proof; remove the grant and add the missing capability to the driver kit instead. The list of driver assemblies is CosmosDriverAssemblyNames in Directory.Build.props." />
  </Target>

  <!-- Clang is the same binary name on all platforms — no per-platform resolution needed.
       CCPath defaults to 'clang' in Cosmos.Build.CC.props. -->

</Project>
