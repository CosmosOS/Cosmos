<Project Sdk="Cosmos.Sdk">

  <PropertyGroup>
    <CosmosKernelClass>DevKernel.Kernel</CosmosKernelClass>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Drivers/ uses the experimental driver kit; see docs/articles/user/drivers.md. -->
    <NoWarn>$(NoWarn);COSMOS0003</NoWarn>
  </PropertyGroup>

  <!-- Core kernel packages (resolved from local-packages NuGet source set up by `make setup`).
       Versions are managed centrally in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" />
    <PackageReference Include="Cosmos.Kernel.System" />
  </ItemGroup>

  <!-- DevKernel-specific C files -->
  <ItemGroup>
    <GCCProject Include="./src/C/" />
    <DirectPInvoke Include="test" />
  </ItemGroup>

</Project>
