<Project Sdk="Cosmos.Sdk">

  <PropertyGroup>
    <CosmosKernelClass>DevKernel.Kernel</CosmosKernelClass>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Drivers/SampleDriver.cs and the sampledev command are written over the experimental driver kit seam (COSMOS0003). -->
    <NoWarn>$(NoWarn);COSMOS0003</NoWarn>
  </PropertyGroup>

  <!-- Core kernel packages (resolved from local-packages NuGet source set up by `make setup`).
       Versions are managed centrally in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" />
    <PackageReference Include="Cosmos.Kernel.System" />
  </ItemGroup>

  <!-- The FTP server behind the ftpd command (CosmosOS/CosmosFtp). A clone of
       that repository next to this one is built from source, so a change to
       the server can be tried in the DevKernel before it is published;
       otherwise the package comes from nuget.org. -->
  <PropertyGroup>
    <CosmosFtpServerProject>$(MSBuildThisFileDirectory)../../../CosmosFtp/src/CosmosFtpServer/CosmosFtpServer.csproj</CosmosFtpServerProject>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(CosmosFtpServerProject)')">
    <ProjectReference Include="$(CosmosFtpServerProject)" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(CosmosFtpServerProject)')">
    <PackageReference Include="CosmosFtpServer" />
  </ItemGroup>

  <!-- DevKernel-specific C files -->
  <ItemGroup>
    <GCCProject Include="./src/C/" />
    <DirectPInvoke Include="test" />
  </ItemGroup>

</Project>
