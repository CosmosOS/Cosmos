<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Unsafe code is contained in Cosmos.Kernel.Core: this layer reaches memory through its address-based entry points. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>Cosmos.Kernel.HAL.X64</PackageId>
    <Title>Cosmos Kernel HAL X64</Title>
    <Description>Hardware abstraction layer X64 implementation for Cosmos kernel.</Description>
    <PackageTags>cosmos;kernel;hal;x64;hardware</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <DefineConstants>$(DefineConstants);ARCH_X64</DefineConstants>
    <!-- The machine description seeds the platform bus through the experimental driver kit seam (COSMOS0003). -->
    <NoWarn>$(NoWarn);COSMOS0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cosmos.Kernel.Core\Cosmos.Kernel.Core.csproj" />
    <ProjectReference Include="..\Cosmos.Kernel.Core.X64\Cosmos.Kernel.Core.X64.csproj" />
    <ProjectReference Include="..\Cosmos.Kernel.HAL\Cosmos.Kernel.HAL.csproj" />
    <ProjectReference Include="..\Cosmos.Build.Analyzer.Patcher\Cosmos.Build.Analyzer.Patcher.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DateTime and Interop.Sys plugs read the CmosRtc singleton. -->
    <InternalsVisibleTo Include="Cosmos.Kernel.Plugs" />
    <!-- White-box timer suite exercises PIT and CmosRtc directly. -->
    <InternalsVisibleTo Include="Cosmos.Kernel.Tests.Timer" />
  </ItemGroup>
</Project>