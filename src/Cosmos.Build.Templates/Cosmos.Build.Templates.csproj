<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Cosmos.Build.Templates</PackageId>
    <Title>Cosmos Build Templates</Title>
    <Description>Build templates and configuration files for Cosmos kernel development including linker scripts, bootloader configurations, and dotnet new project templates.</Description>
    <PackageTags>cosmos;build;templates;dotnet-new;kernel;os</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>

    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <!-- Exclude all code files from compilation -->
  <ItemGroup>
    <Compile Remove="**\*" />
  </ItemGroup>

  <!-- One template per language. KernelName.csproj and KernelName.vbproj are
       materialized verbatim by `dotnet new cosmos-kernel-csharp` and
       `dotnet new cosmos-kernel-vb`, and carry @CosmosPackageVersion@ tokens
       that must be replaced with the literal version at pack time, so they
       are left out of the Content below and re-injected by
       GenerateKernelTemplateProjects. -->
  <ItemGroup>
    <KernelTemplateProject Include="templates\cosmos-kernel-csharp\KernelName.csproj" />
    <KernelTemplateProject Include="templates\cosmos-kernel-vb\KernelName.vbproj" />
  </ItemGroup>

  <!-- Each template's own files keep their path in the package. The files the
       templates share (the bootloader configuration, the VS Code tasks and
       launch configurations, the native source folder) live once under
       templates\common and are packed into each template's folder. -->
  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\common\**;@(KernelTemplateProject)" />
    <Content Include="templates\common\**\*" PackagePath="content\templates\cosmos-kernel-csharp" />
    <Content Include="templates\common\**\*" PackagePath="content\templates\cosmos-kernel-vb" />
    <Content Include="Linker\**\*" />
    <Content Include="Bootloader\**\*" />
  </ItemGroup>

  <!-- Writes each template project with @CosmosPackageVersion@ substituted
       under the intermediate path, and packs it in the template's folder. The
       target runs once per project. -->
  <Target Name="GenerateKernelTemplateProjects"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(KernelTemplateProject)"
          Outputs="$(IntermediateOutputPath)%(KernelTemplateProject.RelativeDir)%(KernelTemplateProject.Filename)%(KernelTemplateProject.Extension)">
    <PropertyGroup>
      <_KernelTemplateProjectPath>%(KernelTemplateProject.RelativeDir)%(KernelTemplateProject.Filename)%(KernelTemplateProject.Extension)</_KernelTemplateProjectPath>
      <_KernelTemplateProjectBaked>$([System.IO.File]::ReadAllText('%(KernelTemplateProject.FullPath)').Replace('@CosmosPackageVersion@', '$(VersionPrefix)'))</_KernelTemplateProjectBaked>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)%(KernelTemplateProject.RelativeDir)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)$(_KernelTemplateProjectPath)"
                      Lines="$(_KernelTemplateProjectBaked)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)$(_KernelTemplateProjectPath)" />
      <Content Include="$(IntermediateOutputPath)$(_KernelTemplateProjectPath)"
               PackagePath="content\$(_KernelTemplateProjectPath)"
               Pack="true"
               Visible="false" />
    </ItemGroup>
  </Target>

</Project>
