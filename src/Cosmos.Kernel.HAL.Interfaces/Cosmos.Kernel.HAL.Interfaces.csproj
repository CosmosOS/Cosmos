<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Public surface tracked in PublicAPI.Shipped/Unshipped.txt (see Directory.Build.props):
             IBlockDevice, the one device contract kernels really implement and
             drive (the Fat and File suites each supply a RAM disk, DevKernel
             reads and writes blocks through it), MACAddress, which the packet
             seam and NetworkManager both hand out, and SoftwareTimer as the
             handle TimerManager.Schedule returns. SoftwareTimer's construction
             and tick members stay internal: they belong to the timer device,
             and a kernel calling them corrupts the registry. -->
        <CosmosTrackPublicApi>true</CosmosTrackPublicApi>
    </PropertyGroup>

    <ItemGroup>
        <!-- The rest are internal because no kernel can obtain or meaningfully
             supply one: the boot contract (IPlatformInitializer) and the
             timer and network devices, whose only registration callers are
             System's own LibraryInitializer and its network consumer. A
             kernel reads NetworkManager.Name/MacAddress/LinkUp/Ready, never
             the device, exactly as it reads KeyboardManager.ReadKey; the
             input kinds are the driver kit's IKeyboard and IPointer. -->
        <InternalsVisibleTo Include="Cosmos.Kernel.HAL" />
        <InternalsVisibleTo Include="Cosmos.Kernel.HAL.X64" />
        <InternalsVisibleTo Include="Cosmos.Kernel.HAL.ARM64" />
        <!-- The aggregator's and System's library initializers read
             PlatformHAL.Initializer during boot, through var. -->
        <InternalsVisibleTo Include="Cosmos.Kernel" />
        <InternalsVisibleTo Include="Cosmos.Kernel.System" />
        <!-- The white-box storage suite maps a high BAR through
             PlatformHAL.Initializer.EnsureMmioMapped. -->
        <InternalsVisibleTo Include="Cosmos.Kernel.Tests.Storage" />
        <!-- The white-box network suite checks that the stack attached its
             packet handler to the device, which the ring does not report. -->
        <InternalsVisibleTo Include="Cosmos.Kernel.Tests.Network" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cosmos.Build.API\Cosmos.Build.API.csproj" />
        <ProjectReference Include="..\Cosmos.Kernel.Core\Cosmos.Kernel.Core.csproj" />
        <ProjectReference Include="..\Cosmos.Build.Analyzer.Patcher\Cosmos.Build.Analyzer.Patcher.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
