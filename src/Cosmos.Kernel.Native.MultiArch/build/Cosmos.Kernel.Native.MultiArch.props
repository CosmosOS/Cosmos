<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <GCCProject Include="$(MSBuildThisFileDirectory)/C/" />
  </ItemGroup>

  <!-- ACPI/uACPI shared sources -->
  <ItemGroup>
    <GCCProject Include="$(MSBuildThisFileDirectory)/ACPI/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)/ACPI/uacpi/source/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)/ACPI/uacpi/include/" />
  </ItemGroup>
</Project>
