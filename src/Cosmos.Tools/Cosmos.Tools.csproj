<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Tool configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cosmos</ToolCommandName>
    <PackageOutputPath>../../artifacts/package/release</PackageOutputPath>

    <!-- Package metadata -->
    <PackageId>Cosmos.Tools</PackageId>
    <Title>Cosmos Development Tools</Title>
    <Description>CLI tools for Cosmos kernel development. Includes tool checking, installation, project creation, building, and QEMU integration.</Description>
    <PackageTags>cosmos;kernel;os;tools;cli;qemu;nativeaot</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cosmos.Tests.Patcher" />
    <InternalsVisibleTo Include="Cosmos.Tests.Tools" />
  </ItemGroup>

</Project>
