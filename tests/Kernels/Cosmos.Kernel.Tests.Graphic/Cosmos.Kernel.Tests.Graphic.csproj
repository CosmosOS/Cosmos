<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Cosmos.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The display tests read the experimental driver kit seam (COSMOS0003):
         the IDisplayModes, IHardwareCursor and ISvgaAdapter facets and the
         ICanvas3DFactory through DisplayDevice.TryGetFacet. -->
    <NoWarn>$(NoWarn);COSMOS0003</NoWarn>
  </PropertyGroup>

  <!-- Core kernel packages (using project references for development) -->
  <ItemGroup>
    <ProjectReference Include="../../../src/Cosmos.Kernel/Cosmos.Kernel.csproj" />
    <ProjectReference Include="../../../src/Cosmos.Kernel.System/Cosmos.Kernel.System.csproj" />
    <ProjectReference Include="../../Cosmos.TestRunner.Framework/Cosmos.TestRunner.Framework.csproj" />
  </ItemGroup>

  <!-- Hardware matrix (tests/profiles.json). The display is a kit display on
       every cell, and the primary one is what the console draws on: on
       `bare` the firmware framebuffer (VBE over q35's std VGA on x64, ramfb
       on arm64); on `vmware-svga` the VMware SVGA II adapter through
       VmwareSvgaDriver, with the firmware framebuffer retired since it was
       the same device; on `virtio-gpu`, which adds a virtio-gpu-pci beside
       the default adapter on both arches, the VirtioGpuDriver's display
       beside the firmware one. Every cell registers the same 24 tests: the
       SVGA facet and FIFO wire tests skip without the adapter, the
       virtio-gpu state test skips without the device, and the cell is read
       from the device tree so a driver that failed to bind fails the suite
       instead of skipping it. -->
  <ItemGroup>
    <CosmosTestProfile Include="bare" />
    <CosmosTestProfile Include="vmware-svga" />
    <CosmosTestProfile Include="virtio-gpu" />
  </ItemGroup>

  <!-- Architecture-specific HAL (using project references for development) -->
  <ItemGroup Condition="'$(DefineConstants)' != '' AND $(DefineConstants.Contains('ARCH_X64'))">
    <ProjectReference Include="../../../src/Cosmos.Kernel.HAL.X64/Cosmos.Kernel.HAL.X64.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DefineConstants)' != '' AND $(DefineConstants.Contains('ARCH_ARM64'))">
    <ProjectReference Include="../../../src/Cosmos.Kernel.HAL.ARM64/Cosmos.Kernel.HAL.ARM64.csproj" />
  </ItemGroup>

</Project>
