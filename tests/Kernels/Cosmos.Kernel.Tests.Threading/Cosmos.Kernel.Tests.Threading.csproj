<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Cosmos.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- White-box suite over the experimental scheduler seam (COSMOS0001). -->
    <NoWarn>$(NoWarn);COSMOS0001</NoWarn>
  </PropertyGroup>

  <!-- The share and ticket cells measure the policies with this suite's own
       threads only. The shipped E1000E driver, bound to q35's default NIC on
       x64, schedules a 50 ms periodic drain on the driver kit's worker, so a
       thread outside the suite wakes and blocks twenty times a second while
       a cell runs: the suite's Round-Robin policy then shares two equal
       spinners two to one instead of evenly, and the ticket total moves
       between the idle-contention cell's two reads. The driver is left out of
       this kernel's manifest so the cells keep measuring the policies and
       not the worker; how the test policy rotates around a thread that wakes
       and blocks is a question for the policy, not for the driver. On arm64
       the virt machine's default NIC is a virtio-net-pci function; without
       gic-version=3 the machine has no ITS, so the kit routes no message
       interrupt to it and VirtioNetDriver falls back to a 50 ms periodic
       drain on the worker, the same wake the E1000E exclusion removes on
       x64, so it is left out too. -->
  <ItemGroup>
    <CosmosDriverExclude Include="Cosmos.Kernel.Drivers.E1000EDriver" />
    <CosmosDriverExclude Include="Cosmos.Kernel.Drivers.VirtioNetDriver" />
  </ItemGroup>

  <!-- Core kernel packages (using project references for development) -->
  <ItemGroup>
    <ProjectReference Include="../../../src/Cosmos.Kernel/Cosmos.Kernel.csproj" />
    <ProjectReference Include="../../../src/Cosmos.Kernel.System/Cosmos.Kernel.System.csproj" />
    <ProjectReference Include="../../Cosmos.TestRunner.Framework/Cosmos.TestRunner.Framework.csproj" />
  </ItemGroup>

  <!-- Architecture-specific HAL (using project references for development) -->
  <ItemGroup Condition="'$(DefineConstants)' != '' AND $(DefineConstants.Contains('ARCH_X64'))">
    <ProjectReference Include="../../../src/Cosmos.Kernel.HAL.X64/Cosmos.Kernel.HAL.X64.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DefineConstants)' != '' AND $(DefineConstants.Contains('ARCH_ARM64'))">
    <ProjectReference Include="../../../src/Cosmos.Kernel.HAL.ARM64/Cosmos.Kernel.HAL.ARM64.csproj" />
  </ItemGroup>

</Project>
