{
  // Global QEMU profile catalog. Two orthogonal axes:
  //   * profiles: a hardware "shape": the disks, NIC ("nic"), input
  //     devices ("keyboard"/"mouse"), VGA adapter ("vga", a -vga backend
  //     name that REPLACES the architecture default rather than adding a
  //     second adapter) and display device ("gpu", a -device model ADDED
  //     alongside that default) attached. An optional "architectures" filter
  //     pins a profile to the arch that can present that hardware; a suite
  //     listing per-arch profiles runs the matching one on each.
  //   * modifiers: generic knobs that compose with a profile. Two flavors:
  //       - deviceOptions: per-disk-kind overrides (msix tuning, cache mode)
  //       - machineOptions: -M property overrides (gic-version, ...)
  //     plus an optional architectures filter so arch-specific knobs (GIC) are
  //     silently skipped on the wrong arch.
  //
  // A modifier with only deviceOptions is gated on at least one matching disk
  // kind in the profile; a modifier with machineOptions applies regardless of
  // what's attached. A suite opts in via <CosmosTestProfile/> and
  // <CosmosTestModifier/> items; test names are prefixed [profile] or
  // [profile+modifier].
  "profiles": [
    {
      // No devices attached. A base for non-storage suites (e.g. Interrupts)
      // that only want machine modifiers like gic-version composed onto them.
      "name": "bare"
    },
    {
      // One disk on an ich9-ahci controller the engine adds to the machine.
      // The kit's AhciDriver binds the controller, publishes the disk
      // as sata0 and the storage manager registers and scans it inside the
      // probe ("[StorageManager] sata0 registered by AhciDriver (primary)").
      // The cell proves the polled SATA command path, one page per command,
      // under the block-device, partition and reboot assertions, and that
      // the disk shows in DriverInfo as a consumed block device.
      "name": "ahci",
      "disks": [
        { "type": "ahci" }
      ]
    },
    {
      // One NVMe controller with one namespace. The kit's NvmeDriver binds
      // it, publishes the namespace as nvme0n1 and the storage manager
      // registers and scans it inside the probe. The cell proves the NVMe
      // queue path under the same assertions, in interrupt mode where the
      // platform routes message 1 (x64, arm64 with gicv3) and polled where
      // it cannot (gicv2), which Profile_NvmeInterruptModeMatches pins, and
      // on x64 the 64-bit BAR relocation probes.
      "name": "nvme",
      "disks": [
        { "type": "nvme" }
      ]
    },
    {
      // A USB stick: usb-storage (SCSI over the Bulk-Only Transport) on a
      // qemu-xhci controller, which attaches it at SuperSpeed. The kit's
      // XhciDriver binds the controller, its bus publishes the stick's mass
      // storage interface as usb:1-1:0, UsbMassStorageDriver binds it and
      // publishes the disk as usb0, and the storage manager registers and
      // scans it inside the probe. Covers the xHCI bulk endpoints, the mass
      // storage class driver and USB hot-plug (the UsbHotPlug_* tests pull
      // the stick out and back in) under the same block-device assertions
      // as the ahci and nvme cells.
      "name": "usb",
      "disks": [
        { "type": "usb" }
      ]
    },
    {
      // A USB keyboard (usb-kbd) on a qemu-xhci controller, plugged in at
      // boot. The kit's XhciDriver binds the controller and publishes the
      // keyboard's HID interface as a usb: node, which UsbKeyboardDriver
      // binds after the Drivers suite's UsbDeclineDriver opened its pipe
      // and declined. The suite then unplugs and replugs it through the
      // engine's usb-kbd-unplug and usb-kbd-plug host requests. The
      // keyboard is a USB 2 device: QEMU's xHCI numbers its USB 3 ports
      // 1 to 4 and its USB 2 ports 5 to 8, so the node is usb:1-5:0.
      "name": "usb-kbd",
      "keyboard": "usb-kbd"
    },
    {
      // Intel E1000E NIC, the historical x64 default, kept as an explicit
      // cell so the driver keeps its coverage now that the NIC is a choice.
      "name": "e1000e",
      "architectures": ["x64"],
      "nic": "e1000e"
    },
    {
      // virtio-net over PCI, NIC only: the data-path cell for the network
      // suite. One shape on both arches; only the MSI backend differs
      // underneath (LAPIC on x64, GICv3 ITS on arm64).
      "name": "virtio-net-pci",
      "architectures": ["x64", "arm64"],
      "machineOptions": { "arm64": { "gic-version": "3" } },
      "nic": "virtio-net-pci"
    },
    {
      // virtio-net over MMIO, what the arm64 virt machine presents, and
      // what the suite ran with before NICs became a profile axis.
      "name": "virtio-net-mmio",
      "architectures": ["arm64"],
      "nic": "virtio-net-device"
    },
    {
      // VMware SVGA II adapter in place of the default stdvga: the
      // VmwareSvgaDriver cell. The driver binds the adapter and publishes
      // its own display, and the firmware display Limine set up on the same
      // adapter is retired ("firmware display "framebuffer" retired: inside
      // pci:0000:00:01.0 bar 1"), so the manager lists the driver's display
      // alone and the SVGA facet and FIFO wire tests run here. x64-only
      // because the device is programmed through PCI port I/O.
      "name": "vmware-svga",
      "architectures": ["x64"],
      "vga": "vmware"
    },
    {
      // virtio-gpu on the PCI bus, ADDED next to the machine's default
      // adapter rather than replacing it ("gpu", not "vga"). Two reasons it
      // has to be additive:
      //   * The default adapter is what the firmware hands Limine (VBE over
      //     q35's std VGA, ramfb on virt), so keeping it means the firmware
      //     display stays published beside the driver's, and the cell
      //     differs from `bare` only by the device on the bus.
      //   * -vga virtio would work on q35 (it resolves to the VGA-compatible
      //     virtio-vga), but virt has no such variant and refuses it outright
      //     with "Virtio VGA not available", so one shape spanning both
      //     arches has to go through -device.
      //
      // This is the cell the virtio-gpu driver actually runs in: the
      // VirtioGpuDriver publishes a display the manager prefers over the
      // firmware one, so the suite's canvas tests render through it here and
      // over the firmware framebuffer on bare, same assertions, both paths.
      // The suite derives the cell from the device tree and fails when the
      // driver did not bind; the binding shows in the boot log as
      // "offer VirtioGpuDriver -> bound".
      //
      // gic-version=3 on arm64 for the same reason as virtio-pci: virtio-pci
      // MSI-X is routed by the GICv3 ITS and virt defaults to GICv2, which has
      // none. q35 rejects the property, hence the scoping.
      "name": "virtio-gpu",
      "architectures": ["x64", "arm64"],
      "machineOptions": { "arm64": { "gic-version": "3" } },
      "gpu": "virtio-gpu-pci"
    },
    {
      // Every virtio device kind the kernel has a driver for, over PCI.
      // Exercises capability parsing, MSI-X setup and driver binding for both
      // the network and input paths. Runs on both arches: q35 has no
      // virtio-mmio window at all, and the arm64 virt machine has a PCIe host
      // bridge alongside its MMIO one, so this is the same hardware shape in
      // both columns.
      //
      // gic-version=3 is required on arm64, not cosmetic: MSI-X is routed by
      // the GICv3 ITS, and the virt machine defaults to GICv2, which has none:
      // MsiRouting would never get a binder and the transport would refuse
      // to bring the device up. q35 rejects the property, hence the scoping.
      "name": "virtio-pci",
      "architectures": ["x64", "arm64"],
      "machineOptions": { "arm64": { "gic-version": "3" } },
      "nic": "virtio-net-pci",
      "keyboard": "virtio-keyboard-pci",
      "mouse": "virtio-mouse-pci"
    },
    {
      // The same device set over the virt machine's virtio-mmio window, so
      // one suite covers both transports with the same assertions.
      "name": "virtio-mmio",
      "architectures": ["arm64"],
      "nic": "virtio-net-device",
      "keyboard": "virtio-keyboard-device",
      "mouse": "virtio-mouse-device"
    }
  ],
  "modifiers": [
    {
      // Force GICv2 (legacy distributor). cortex-a72 supports both v2 and v3,
      // so flipping this exercises the kernel's GICv2 IRQ-ack/EOI path
      // separate from GICv3 ICC_* system registers.
      "name": "gicv2",
      "architectures": ["arm64"],
      "machineOptions": { "gic-version": "2" }
    },
    {
      // Force GICv3. Default on most newer QEMU virt machines, but pinning
      // it makes the test matrix explicit and disambiguates from `auto`.
      "name": "gicv3",
      "architectures": ["arm64"],
      "machineOptions": { "gic-version": "3" }
    },
    {
      // Disable ACPI on the machine. Default is acpi=on for both q35 and
      // virt; flipping it forces the kernel onto its non-ACPI discovery
      // paths (no MADT/IORT/MCFG, fall back to FDT or hard-coded layout).
      // Useful smoke for "ACPI tables absent" code; on x64 it typically
      // disables PCIe enumeration and surfaces as missing devices in the
      // dependent tests via the existing TR.RunIf gating.
      "name": "acpi-off",
      "machineOptions": { "acpi": "off" }
    }
  ]
}
