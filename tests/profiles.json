{
  // Global QEMU profile catalog. Two orthogonal axes:
  //   * profiles  — a hardware "shape": the disks, NIC ("nic"), input
  //     devices ("keyboard"/"mouse"), VGA adapter ("vga", a -vga backend
  //     name that REPLACES the architecture default rather than adding a
  //     second adapter) and display device ("gpu", a -device model ADDED
  //     alongside that default) attached, plus two list axes:
  //       - "devices": extra -device models, e.g. ["edu"] or ["rtl8139"].
  //         Each must be a model ProfileDeviceModels (test runner) knows,
  //         so a typo fails the catalog load rather than QEMU. A NIC model
  //         gets a user-mode netdev of its own, and like "nic" that drops
  //         QEMU's default NIC.
  //       - "usb": USB models, e.g. ["usb-mouse", "usb-tablet"], checked the
  //         same way and placed on one qemu-xhci controller, the one a USB
  //         disk uses when the profile has one. This is the axis for USB
  //         devices: "mouse"/"keyboard" emit a bare -device, and neither q35
  //         nor virt has a USB bus of its own to put it on.
  //     Entries are plain strings, not objects, and a model appears once per
  //     profile, counting "nic", "keyboard", "mouse" and "gpu" too.
  //     An optional "architectures" filter pins a profile to the arch that
  //     can present that hardware; a suite listing per-arch profiles runs
  //     the matching one on each.
  //   * modifiers — generic knobs that compose with a profile. Two flavors:
  //       - deviceOptions: per-disk-kind overrides (msix tuning, cache mode)
  //       - machineOptions: -M property overrides (gic-version, ...)
  //     plus an optional architectures filter so arch-specific knobs (GIC) are
  //     silently skipped on the wrong arch.
  //
  // A modifier with only deviceOptions is gated on at least one matching disk
  // kind in the profile; a modifier with machineOptions applies regardless of
  // what's attached. A suite opts in via <CosmosTestProfile/> and
  // <CosmosTestModifier/> items; test names are prefixed [profile] or
  // [profile+modifier].
  "profiles": [
    {
      // No devices attached. A base for non-storage suites (e.g. Interrupts)
      // that only want machine modifiers like gic-version composed onto them.
      "name": "bare"
    },
    {
      "name": "ahci",
      "disks": [
        { "type": "ahci" }
      ]
    },
    {
      "name": "nvme",
      "disks": [
        { "type": "nvme" }
      ]
    },
    {
      // A USB stick: usb-storage (SCSI over the Bulk-Only Transport) on a
      // qemu-xhci controller, which attaches it at SuperSpeed. Covers the
      // xHCI bulk endpoints and the mass storage class driver under the same
      // block-device assertions as the ahci and nvme cells.
      "name": "usb",
      "disks": [
        { "type": "usb" }
      ]
    },
    {
      // Intel E1000E NIC — the historical x64 default, kept as an explicit
      // cell so the driver keeps its coverage now that the NIC is a choice.
      "name": "e1000e",
      "architectures": ["x64"],
      "nic": "e1000e"
    },
    {
      // virtio-net over PCI, NIC only — the data-path cell for the network
      // suite. One shape on both arches; only the MSI backend differs
      // underneath (LAPIC on x64, GICv3 ITS on arm64).
      "name": "virtio-net-pci",
      "architectures": ["x64", "arm64"],
      "machineOptions": { "arm64": { "gic-version": "3" } },
      "nic": "virtio-net-pci"
    },
    {
      // virtio-net over MMIO — what the arm64 virt machine presents, and
      // what the suite ran with before NICs became a profile axis.
      "name": "virtio-net-mmio",
      "architectures": ["arm64"],
      "nic": "virtio-net-device"
    },
    {
      // VMware SVGA II adapter in place of the default stdvga. The kernel has
      // no SVGAII driver yet — the suite drives GOP on both cells — so today
      // this proves the firmware-framebuffer path is adapter-agnostic: the
      // device embeds a std VGA core with Bochs VBE, so Limine still hands
      // the kernel a framebuffer. Becomes the SVGAII driver cell once that
      // driver is ported. x64-only because the device is programmed through
      // PCI port I/O.
      "name": "vmware-svga",
      "architectures": ["x64"],
      "vga": "vmware"
    },
    {
      // virtio-gpu on the PCI bus, ADDED next to the machine's default
      // adapter rather than replacing it ("gpu", not "vga"). Two reasons it
      // has to be additive:
      //   * The default adapter is what the firmware hands Limine — VBE over
      //     q35's std VGA, ramfb on virt — so keeping it means the suite's
      //     existing framebuffer assertions still have a framebuffer, and the
      //     cell differs from `bare` only by the device on the bus.
      //   * -vga virtio would work on q35 (it resolves to the VGA-compatible
      //     virtio-vga), but virt has no such variant and refuses it outright
      //     with "Virtio VGA not available" — so one shape spanning both
      //     arches has to go through -device.
      //
      // This is the cell the virtio-gpu driver actually runs in:
      // FullScreenCanvas prefers a ready VirtioGpu over SVGA-II and GOP, so
      // the suite's canvas tests render through VirtioGpuCanvas here and over
      // the firmware framebuffer in the other cells — same assertions, both
      // paths. A driver that fails to bind does not skip the cell, it falls
      // back to GOP and passes quietly, so the binding itself is worth
      // checking in the boot log ("[VirtioGpu] Initialization complete").
      //
      // gic-version=3 on arm64 for the same reason as virtio-pci: virtio-pci
      // MSI-X is routed by the GICv3 ITS and virt defaults to GICv2, which has
      // none. q35 rejects the property, hence the scoping.
      "name": "virtio-gpu",
      "architectures": ["x64", "arm64"],
      "machineOptions": { "arm64": { "gic-version": "3" } },
      "gpu": "virtio-gpu-pci"
    },
    {
      // Every virtio device kind the kernel has a driver for, over PCI.
      // Exercises capability parsing, MSI-X setup and driver binding for both
      // the network and input paths. Runs on both arches: q35 has no
      // virtio-mmio window at all, and the arm64 virt machine has a PCIe host
      // bridge alongside its MMIO one, so this is the same hardware shape in
      // both columns.
      //
      // gic-version=3 is required on arm64, not cosmetic: MSI-X is routed by
      // the GICv3 ITS, and the virt machine defaults to GICv2, which has none
      // — MsiRouting would never get a binder and the transport would refuse
      // to bring the device up. q35 rejects the property, hence the scoping.
      "name": "virtio-pci",
      "architectures": ["x64", "arm64"],
      "machineOptions": { "arm64": { "gic-version": "3" } },
      "nic": "virtio-net-pci",
      "keyboard": "virtio-keyboard-pci",
      "mouse": "virtio-mouse-pci"
    },
    {
      // The same device set over the virt machine's virtio-mmio window, so
      // one suite covers both transports with the same assertions.
      "name": "virtio-mmio",
      "architectures": ["arm64"],
      "nic": "virtio-net-device",
      "keyboard": "virtio-keyboard-device",
      "mouse": "virtio-mouse-device"
    },
    {
      // The four profiles below are the Drivers suite's cells: hardware no
      // built-in driver claims, left for a user driver to bind. Each adds
      // it to the machine's defaults once, so the suite can pin that exactly
      // one such function or interface came up and that nothing owns it.
      //
      // QEMU's educational device (1234:11e8): an MMIO BAR with an ID
      // register, a factorial unit, an interrupt it raises on request and a
      // DMA engine.
      "name": "edu",
      "architectures": ["x64", "arm64"],
      "devices": ["edu"]
    },
    {
      // Realtek RTL8139 (10ec:8139), which no built-in driver takes on
      // either arch. Its user-mode netdev gives it a DHCP server to get a
      // lease from; like "nic", that drops QEMU's default NIC.
      "name": "rtl8139",
      "architectures": ["x64", "arm64"],
      "devices": ["rtl8139"]
    },
    {
      // Intel 82574L (8086:10d3). The E1000E built-in claims it on x64, so
      // only arm64 presents it unclaimed. No gic-version here: a suite pins
      // the GIC with the gicv2/gicv3 modifiers, and a modifier overwrites a
      // profile's own -M value rather than conflicting with it, so a GICv3
      // pin here would turn silently into GICv2 under +gicv2.
      "name": "e1000e-arm64",
      "architectures": ["arm64"],
      "devices": ["e1000e"]
    },
    {
      // A USB mouse, a USB tablet and a USB keyboard on qemu-xhci root
      // ports, and no USB stick. The xHCI built-in owns the controller; no
      // class driver takes a HID mouse interface (class 3, subclass 1,
      // protocol 2) or the tablet's (class 3, no boot subclass or protocol),
      // so both are left to the suite's USB drivers, while the built-in
      // keyboard driver takes the keyboard's (class 3, subclass 1, protocol
      // 1) before any of them. All three share QEMU's HID IDs, 0627:0001.
      // The suite pulls each one out and plugs it back in by its index in
      // this list, so the order is part of the suite.
      "name": "usb-hid",
      "architectures": ["x64", "arm64"],
      "usb": ["usb-mouse", "usb-tablet", "usb-kbd"]
    }
  ],
  "modifiers": [
    {
      // Force GICv2 (legacy distributor). cortex-a72 supports both v2 and v3,
      // so flipping this exercises the kernel's GICv2 IRQ-ack/EOI path
      // separate from GICv3 ICC_* system registers.
      "name": "gicv2",
      "architectures": ["arm64"],
      "machineOptions": { "gic-version": "2" }
    },
    {
      // Force GICv3. Default on most newer QEMU virt machines, but pinning
      // it makes the test matrix explicit and disambiguates from `auto`.
      "name": "gicv3",
      "architectures": ["arm64"],
      "machineOptions": { "gic-version": "3" }
    },
    {
      // Disable ACPI on the machine. Default is acpi=on for both q35 and
      // virt; flipping it forces the kernel onto its non-ACPI discovery
      // paths (no MADT/IORT/MCFG, fall back to FDT or hard-coded layout).
      // Useful smoke for "ACPI tables absent" code; on x64 it typically
      // disables PCIe enumeration and surfaces as missing devices in the
      // dependent tests via the existing TR.RunIf gating.
      "name": "acpi-off",
      "machineOptions": { "acpi": "off" }
    }
  ]
}
